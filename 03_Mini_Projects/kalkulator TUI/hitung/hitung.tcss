/* Palet mengikuti theme.py */
Screen {
    background: #0B0E14;
    color: #E6EDF3;
    layout: vertical;
}

#topbar {
    height: 1;
    layout: horizontal;
    padding: 0 1;
    background: #0B0E14;
}

#brand {
    width: auto;
    color: #4C8DFF;
    text-style: bold;
}

#subtitle {
    width: 1fr;
    padding-left: 1;
    color: #93A1B3;
}

#today {
    width: auto;
    padding-right: 2;
    color: #93A1B3;
}

#clock {
    width: auto;
    color: #93A1B3;
    text-align: right;
}

#body {
    height: 1fr;
    layout: horizontal;
    align: center middle;
    padding: 1 2;
}

CalcCard {
    width: 1fr;
    max-width: 74;
    height: 100%;
    border: round #2A3444;
    background: #111827;
    padding: 1 2;
    align: center middle;
}

CalcCard #result-label {
    width: 100%;
    height: 1;
    color: #93A1B3;
}

CalcCard #result {
    width: 100%;
    height: 3;
    text-align: center;
    content-align: center middle;
    color: #6FD3A8;
    text-style: bold;
}

CalcCard #result.-preview {
    color: #4C8DFF;
}

CalcCard #last {
    width: 100%;
    height: 1;
    text-align: center;
    color: #93A1B3;
}

CalcCard #expr-label {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: #93A1B3;
}

CalcCard Input {
    background: #0B0E14;
    border: round #2A3444;
}

CalcCard Input:focus {
    border: round #6FD3A8;
}

CalcCard #status {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: #93A1B3;
}

CalcCard #status.-error {
    color: #FF7A6B;
}

HistoryPanel {
    width: 34;
    height: 100%;
    margin-left: 2;
    border: round #2A3444;
    background: #1A202B;
    padding: 1 2;
}

HistoryPanel #history-title {
    width: 100%;
    height: 1;
    color: #93A1B3;
    text-style: bold;
}

HistoryPanel #history-list {
    width: 100%;
    height: auto;
    margin-top: 1;
}

HistoryPanel #history-hint {
    width: 100%;
    height: 1;
    dock: bottom;
    color: #93A1B3;
}

#compact-hint {
    display: none;
    dock: bottom;
    height: 1;
    text-align: center;
    color: #93A1B3;
}

#too-small {
    display: none;
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    color: #93A1B3;
}

Footer {
    height: 1;
    background: #0B0E14;
    color: #93A1B3;
}

FooterKey .footer-key--key {
    color: #E6EDF3;
    background: #0B0E14;
    text-style: bold;
}

FooterKey .footer-key--description {
    color: #93A1B3;
    background: #0B0E14;
}

/* ---------- modal: riwayat ---------- */
HistoryScreen {
    align: center middle;
    background: #0B0E14 82%;
}

#history-box {
    width: 90%;
    max-width: 78;
    height: auto;
    max-height: 96%;
    border: round #2A3444;
    background: #111827;
    padding: 1 2;
}

#history-title {
    color: #6FD3A8;
    text-style: bold;
}

.section-label {
    margin-top: 1;
    color: #93A1B3;
    text-style: bold;
}

#history-hint {
    margin-top: 1;
    color: #93A1B3;
}

#history-scroll {
    height: 7;
    margin-top: 0;
}

#history-buttons {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#history-buttons Button {
    margin-left: 1;
}

/* ---------- modal: pengaturan ---------- */
SettingsScreen {
    align: center middle;
    background: #0B0E14 82%;
}

#settings-box {
    width: 78;
    max-width: 96%;
    height: auto;
    max-height: 96%;
    border: round $border;
    background: $surface;
    padding: 1 2;
}

#settings-title {
    color: $primary;
    text-style: bold;
}

#settings-fields {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 1 2;
    height: auto;
    margin-top: 1;
}

#settings-hint {
    margin-top: 1;
    color: $text-muted;
}

#settings-buttons {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#settings-buttons Button {
    margin-left: 1;
}

/* ---------- modal: bantuan ---------- */
HelpScreen {
    align: center middle;
    background: #0B0E14 82%;
}

#help-box {
    width: 68;
    max-width: 94%;
    height: auto;
    max-height: 96%;
    border: round #2A3444;
    background: #111827;
    padding: 1 2;
}

#help-title {
    color: #6FD3A8;
    text-style: bold;
}

#help-text {
    margin-top: 1;
}

#help-hint {
    margin-top: 1;
    color: #93A1B3;
}

/* ---------- modal: konfirmasi ---------- */
ConfirmScreen {
    align: center middle;
    background: #0B0E14 82%;
}

#confirm-box {
    width: 58;
    max-width: 92%;
    height: auto;
    border: round #FF7A6B;
    background: #111827;
    padding: 1 2;
}

#confirm-title {
    color: #FF7A6B;
    text-style: bold;
}

#confirm-message {
    margin-top: 1;
    color: #E6EDF3;
}

#confirm-buttons {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#confirm-buttons Button {
    margin-left: 1;
}

/* search modal */
SearchScreen { align: center middle; }
#search-box { width: 72; max-width: 96%; max-height: 90%; border: round $border; background: $surface; padding: 1 2; }
#search-title { color: $primary; text-style: bold; margin-bottom: 1; }
#search-list-wrap { height: 16; margin-top: 1; }
#search-buttons { height: 3; align: right middle; margin-top: 1; }
.search-item { width: 100%; margin-bottom: 1; }

/* ---------- tombol: sudut membulat sesuai desain ---------- */
/* Shortcut: gaya bawaan Button memakai border datar (border-top/bottom), aturan ini menimpanya per varian. */
Button.-style-default {
    border: round $border;
}

Button.-style-default:hover {
    border: round $primary;
}

/* ---------- widget v2: shell, sidebar, display, keypad ---------- */
#shell {
    height: 100%;
    layout: horizontal;
}

#sidebar {
    width: 14;
    min-width: 14;
    height: 100%;
    background: $panel;
    border: round $border;
    padding: 0;
    overflow-y: auto;
}

#side-brand {
    height: 2;
    padding: 0 1;
    color: $primary;
    text-style: bold;
    content-align: center middle;
}

/* line-pad: 0 tidak sah di Textual; padding 0 + border none menyisakan 10 kolom teks. */
#sidebar .side-btn {
    width: 100%;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $text-muted;
    content-align: left middle;
}

#sidebar .side-btn:hover,
#sidebar .side-btn:focus {
    background: $surface;
    color: $text;
}

#sidebar .side-btn.-active {
    background: $surface;
    color: $primary;
    text-style: bold;
}

#tools {
    width: 1fr;
    height: 100%;
}

/* display tombol: terpasang di StandardTool sejak Task 3, aktif di Task 4 */
#calc-display {
    display: none;
}

CalculatorDisplay {
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $border;
}

.calc-expression {
    color: $text-muted;
}

.calc-result {
    color: #6FD3A8;
    text-style: bold;
}

.calc-result.-preview {
    color: $primary;
}

.calc-status,
.calc-angle {
    color: $text-muted;
}

ScientificKeypad {
    height: auto;
    layout: grid;
    grid-size: 4;
    grid-gutter: 0 1;
    padding: 1;
}

ScientificKeypad.cols-7 {
    grid-size: 7;
}

#tools .key {
    width: 100%;
    min-width: 0;
    height: 3;
    border: round $border;
    background: $surface;
}

#tools .key:hover {
    background: $surface;
    border: round $primary;
}
