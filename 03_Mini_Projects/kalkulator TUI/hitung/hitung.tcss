/* Palet mengikuti theme.py */
Screen {
    background: #0B0E14;
    color: #E6EDF3;
    layout: vertical;
}

#too-small {
    display: none;
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    color: #93A1B3;
}

Footer {
    height: 1;
    background: #0B0E14;
    color: #93A1B3;
}

FooterKey .footer-key--key {
    color: #E6EDF3;
    background: #0B0E14;
    text-style: bold;
}

FooterKey .footer-key--description {
    color: #93A1B3;
    background: #0B0E14;
}

/* ---------- modal: riwayat ---------- */
HistoryScreen {
    align: center middle;
    background: #0B0E14 82%;
}

#history-box {
    width: 90%;
    max-width: 78;
    height: auto;
    max-height: 96%;
    border: round #2A3444;
    background: #111827;
    padding: 1 2;
}

#history-title {
    color: #6FD3A8;
    text-style: bold;
}

.section-label {
    margin-top: 1;
    color: #93A1B3;
    text-style: bold;
}

#history-hint {
    margin-top: 1;
    color: #93A1B3;
}

#history-scroll {
    height: 7;
    margin-top: 0;
}

#history-buttons {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#history-buttons Button {
    margin-left: 1;
}

/* ---------- modal: pengaturan ---------- */
SettingsScreen {
    align: center middle;
    background: #0B0E14 82%;
}

#settings-box {
    width: 78;
    max-width: 96%;
    height: auto;
    max-height: 96%;
    border: round $border;
    background: $surface;
    padding: 1 2;
}

#settings-title {
    color: $primary;
    text-style: bold;
}

#settings-fields {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 1 2;
    height: auto;
    margin-top: 1;
}

#settings-hint {
    margin-top: 1;
    color: $text-muted;
}

#settings-buttons {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#settings-buttons Button {
    margin-left: 1;
}

/* ---------- modal: bantuan ---------- */
HelpScreen {
    align: center middle;
    background: #0B0E14 82%;
}

#help-box {
    width: 68;
    max-width: 94%;
    height: auto;
    max-height: 96%;
    border: round #2A3444;
    background: #111827;
    padding: 1 2;
}

#help-title {
    color: #6FD3A8;
    text-style: bold;
}

#help-text {
    margin-top: 1;
}

#help-hint {
    margin-top: 1;
    color: #93A1B3;
}

/* ---------- modal: konfirmasi ---------- */
ConfirmScreen {
    align: center middle;
    background: #0B0E14 82%;
}

#confirm-box {
    width: 58;
    max-width: 92%;
    height: auto;
    border: round #FF7A6B;
    background: #111827;
    padding: 1 2;
}

#confirm-title {
    color: #FF7A6B;
    text-style: bold;
}

#confirm-message {
    margin-top: 1;
    color: #E6EDF3;
}

#confirm-buttons {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#confirm-buttons Button {
    margin-left: 1;
}

/* search modal */
SearchScreen { align: center middle; }
#search-box { width: 72; max-width: 96%; max-height: 90%; border: round $border; background: $surface; padding: 1 2; }
#search-title { color: $primary; text-style: bold; margin-bottom: 1; }
#search-list-wrap { height: 16; margin-top: 1; }
#search-buttons { height: 3; align: right middle; margin-top: 1; }
.search-item { width: 100%; margin-bottom: 1; }

/* ---------- tombol: sudut membulat sesuai desain ---------- */
/* Shortcut: gaya bawaan Button memakai border datar (border-top/bottom), aturan ini menimpanya per varian. */
Button.-style-default {
    border: round $border;
}

Button.-style-default:hover {
    border: round $primary;
}

/* ---------- widget v2: shell, sidebar, display, keypad ---------- */
#shell {
    height: 100%;
    layout: horizontal;
}

#sidebar {
    width: 14;
    min-width: 14;
    height: 100%;
    background: $panel;
    border: round $border;
    padding: 0;
    overflow-y: auto;
}

#side-brand {
    height: 2;
    padding: 0 1;
    color: $primary;
    text-style: bold;
    content-align: center middle;
}

/* line-pad: 0 tidak sah di Textual; padding 0 + border none menyisakan 10 kolom teks. */
#sidebar .side-btn {
    width: 100%;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $text-muted;
    content-align: left middle;
}

#sidebar .side-btn:hover,
#sidebar .side-btn:focus {
    background: $surface;
    color: $text;
}

#sidebar .side-btn.-active {
    background: $surface;
    color: $primary;
    text-style: bold;
}

#tools {
    width: 1fr;
    height: 100%;
}

/* display kalkulator standar (Task 4) */
CalculatorDisplay {
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $border;
}

.calc-expression {
    color: $text-muted;
}

.calc-result {
    color: #6FD3A8;
    text-style: bold;
}

.calc-result.-preview {
    color: $primary;
}

.calc-status,
.calc-angle {
    color: $text-muted;
}

ScientificKeypad {
    height: auto;
    layout: grid;
    grid-size: 4;
    grid-gutter: 0 1;
    padding: 1;
}

ScientificKeypad.cols-7 {
    grid-size: 7;
}

#tools .key {
    width: 100%;
    min-width: 0;
    height: 3;
    border: round $border;
    background: $surface;
}

#tools .key:hover {
    background: $surface;
    border: round $primary;
}

/* ---------- konverter unit (Task 7) ---------- */
ConverterTool {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

ConverterTabs {
    height: auto;
    layout: horizontal;
    padding: 0 0 1 0;
}

ConverterTabs .tab {
    width: auto;
    min-width: 0;
    height: 3;
    margin: 0 1 0 0;
    padding: 0 1;
    border: round $border;
    background: $surface;
}

ConverterTabs .tab.-active {
    border: round $primary;
    color: $primary;
    text-style: bold;
}

#conv-panels {
    height: auto;
    layout: horizontal;
}

UnitSelector {
    width: 1fr;
    height: auto;
    padding: 1 2;
    border: round $border;
    background: $surface;
}

UnitSelector:focus {
    border: round $primary;
}

.unit-title {
    height: 1;
    color: $text-muted;
}

.unit-value {
    height: 2;
    color: #6FD3A8;
    text-style: bold;
    content-align: right middle;
}

#conv-swap {
    width: 5;
    min-width: 5;
    height: 3;
    margin: 3 1 0 1;
}

#conv-result {
    height: 2;
    padding: 0 1;
    color: $text;
}

NumericKeypad {
    height: auto;
    layout: grid;
    grid-size: 4;
    grid-gutter: 0 1;
    padding: 1;
}

#conv-key-equals {
    column-span: 4;
}

/* ---------- persentase & tip (Task 8) ---------- */
#pct-title,
#tip-title {
    color: $primary;
    text-style: bold;
    height: 1;
}

#pct-modes,
#tip-quick,
#tip-people-row {
    height: auto;
    layout: horizontal;
    margin: 1 0;
}

.pct-mode,
.tip-quick {
    width: 1fr;
    min-width: 0;
    height: 3;
    margin-right: 1;
    border: round $border;
    background: $surface;
}

.pct-mode:hover,
.pct-mode.-active,
.tip-quick:hover,
.tip-quick.-active {
    border: round $primary;
    color: $primary;
}

#pct-price,
#pct-percent,
#tip-bill,
#tip-percent {
    width: 100%;
}

#pct-out {
    height: auto;
    min-height: 3;
    margin-top: 1;
    padding: 1 2;
    border: round $border;
    background: $surface;
    color: #6FD3A8;
}

#tip-people-minus,
#tip-people-plus {
    width: 5;
    min-width: 5;
    height: 3;
}

#tip-people {
    width: 1fr;
    height: 3;
    margin: 0 1;
}

#tip-results {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1 1;
    height: auto;
    margin-top: 1;
}

.tip-result {
    height: auto;
    padding: 1 2;
    border: round $border;
    background: $surface;
}

.tip-label {
    height: 1;
    color: $text-muted;
}

.tip-value {
    height: 1;
    color: #6FD3A8;
    text-style: bold;
}

/* ---------- dashboard (Task 9) ---------- */
#dash-title {
    height: 1;
    color: $primary;
    text-style: bold;
}

#dash-sub {
    height: 1;
    margin-bottom: 1;
    color: $text-muted;
}

#dash-search {
    margin-bottom: 1;
}

#quick-row {
    height: auto;
    layout: horizontal;
}

.quick-card {
    width: 1fr;
    min-width: 0;
    height: 3;
    margin-right: 1;
    padding: 0 1;
    border: round $border;
    background: $surface;
    text-align: left;
}

.quick-card:hover {
    border: round $primary;
    color: $primary;
}

.section {
    height: 1;
    margin-top: 1;
    color: $text-muted;
    text-style: bold;
}

#dash-columns {
    height: 1fr;
    layout: horizontal;
}

#dash-main {
    width: 1fr;
    height: 1fr;
}

#dash-side {
    width: 40;
    height: 1fr;
    margin-left: 2;
}

.tool-list {
    height: auto;
}

.dash-item {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
}

#recent-head {
    height: auto;
    layout: horizontal;
}

#recent-head .section {
    width: 1fr;
}

.mini {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 1;
    background: transparent;
    color: $text-muted;
}

.mini:hover {
    color: #FF7A6B;
}

#recent-box,
#fav-box {
    height: auto;
    min-height: 3;
    border: round $border;
    padding: 1;
    background: $panel;
}
