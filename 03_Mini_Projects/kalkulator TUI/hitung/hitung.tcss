/* Palet mengikuti theme.py */
Screen {
    background: #12151C;
    color: #E6EDF3;
    layout: vertical;
}

#topbar {
    height: 1;
    layout: horizontal;
    padding: 0 1;
    background: #12151C;
}

#brand {
    width: auto;
    color: #6FD3A8;
    text-style: bold;
}

#subtitle {
    width: 1fr;
    padding-left: 1;
    color: #93A1B3;
}

#today {
    width: auto;
    padding-right: 2;
    color: #93A1B3;
}

#clock {
    width: auto;
    color: #93A1B3;
    text-align: right;
}

#body {
    height: 1fr;
    layout: horizontal;
    align: center middle;
    padding: 1 2;
}

CalcCard {
    width: 1fr;
    max-width: 74;
    height: 100%;
    border: round #2F3A4A;
    background: #1A202B;
    padding: 1 2;
    align: center middle;
}

CalcCard #result-label {
    width: 100%;
    height: 1;
    color: #93A1B3;
}

CalcCard #result {
    width: 100%;
    height: 3;
    text-align: center;
    content-align: center middle;
    color: #6FD3A8;
    text-style: bold;
}

CalcCard #result.-preview {
    color: #8AB4F8;
}

CalcCard #last {
    width: 100%;
    height: 1;
    text-align: center;
    color: #93A1B3;
}

CalcCard #expr-label {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: #93A1B3;
}

CalcCard Input {
    background: #12151C;
    border: round #2F3A4A;
}

CalcCard Input:focus {
    border: round #6FD3A8;
}

CalcCard #status {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: #93A1B3;
}

CalcCard #status.-error {
    color: #FF7A6B;
}

HistoryPanel {
    width: 34;
    height: 100%;
    margin-left: 2;
    border: round #2F3A4A;
    background: #161C26;
    padding: 1 2;
}

HistoryPanel #history-title {
    width: 100%;
    height: 1;
    color: #93A1B3;
    text-style: bold;
}

HistoryPanel #history-list {
    width: 100%;
    height: auto;
    margin-top: 1;
}

HistoryPanel #history-hint {
    width: 100%;
    height: 1;
    dock: bottom;
    color: #93A1B3;
}

#compact-hint {
    display: none;
    dock: bottom;
    height: 1;
    text-align: center;
    color: #93A1B3;
}

#too-small {
    display: none;
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    color: #93A1B3;
}

Footer {
    height: 1;
    background: #12151C;
    color: #93A1B3;
}

FooterKey .footer-key--key {
    color: #E6EDF3;
    background: #12151C;
    text-style: bold;
}

FooterKey .footer-key--description {
    color: #93A1B3;
    background: #12151C;
}

/* ---------- modal: riwayat ---------- */
HistoryScreen {
    align: center middle;
    background: #12151C 82%;
}

#history-box {
    width: 90%;
    max-width: 78;
    height: auto;
    max-height: 96%;
    border: round #2F3A4A;
    background: #1A202B;
    padding: 1 2;
}

#history-title {
    color: #6FD3A8;
    text-style: bold;
}

.section-label {
    margin-top: 1;
    color: #93A1B3;
    text-style: bold;
}

#history-hint {
    margin-top: 1;
    color: #93A1B3;
}

#history-scroll {
    height: 7;
    margin-top: 0;
}

#history-buttons {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#history-buttons Button {
    margin-left: 1;
}

/* ---------- modal: pengaturan ---------- */
SettingsScreen {
    align: center middle;
    background: #12151C 82%;
}

#settings-box {
    width: 78;
    max-width: 96%;
    height: auto;
    max-height: 96%;
    border: round $border;
    background: $surface;
    padding: 1 2;
}

#settings-title {
    color: $primary;
    text-style: bold;
}

#settings-fields {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 1 2;
    height: auto;
    margin-top: 1;
}

#settings-hint {
    margin-top: 1;
    color: $text-muted;
}

#settings-buttons {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#settings-buttons Button {
    margin-left: 1;
}

/* ---------- modal: bantuan ---------- */
HelpScreen {
    align: center middle;
    background: #12151C 82%;
}

#help-box {
    width: 68;
    max-width: 94%;
    height: auto;
    max-height: 96%;
    border: round #2F3A4A;
    background: #1A202B;
    padding: 1 2;
}

#help-title {
    color: #6FD3A8;
    text-style: bold;
}

#help-text {
    margin-top: 1;
}

#help-hint {
    margin-top: 1;
    color: #93A1B3;
}

/* ---------- modal: konfirmasi ---------- */
ConfirmScreen {
    align: center middle;
    background: #12151C 82%;
}

#confirm-box {
    width: 58;
    max-width: 92%;
    height: auto;
    border: round #F0C674;
    background: #1A202B;
    padding: 1 2;
}

#confirm-title {
    color: #F0C674;
    text-style: bold;
}

#confirm-message {
    margin-top: 1;
    color: #E6EDF3;
}

#confirm-buttons {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#confirm-buttons Button {
    margin-left: 1;
}

/* search modal */
SearchScreen { align: center middle; }
#search-box { width: 72; max-width: 96%; max-height: 90%; border: round $border; background: $surface; padding: 1 2; }
#search-title { color: $primary; text-style: bold; margin-bottom: 1; }
#search-list-wrap { height: 16; margin-top: 1; }
#search-buttons { height: 3; align: right middle; margin-top: 1; }
.search-item { width: 100%; margin-bottom: 1; }
